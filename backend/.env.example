# MemeRadar backend secrets and runtime overrides.
# Copy this file to `backend/.env` and fill in the values. Never commit `.env`.

# Helius — Solana RPC + WebSocket discovery (https://helius.dev)
HELIUS_API_KEY=

# RugCheck — public API works without a key; a key raises rate limits
RUGCHECK_API_KEY=

# Telegram alerts (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Live mode is the default. `python run.py --demo` runs the demo dataset.
# Optional SQLAlchemy URL override (default live DB: backend/data/memeradar_live.db)
DATABASE_URL=

# Server bind address
HOST=0.0.0.0
PORT=8000

# Dashboard login (leave DASHBOARD_PASSWORD empty to disable login on localhost)
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=
